def bubbleSort(data_list):
    n = len(data_list)
    for i in range(n):
        swapped = False
        for j in range(0, n - i - 1):
            if data_list[j] > data_list[j + 1]:
                data_list[j], data_list[j + 1] = data_list[j + 1], data_list[j]
                swapped = True
        
        if not swapped:
            break
    
    return data_list

# --- Ví dụ theo đề bài ---
SampleData = [14, 46, 43, 27, 57, 41, 45, 21, 70]

print(f"Danh sách ban đầu: {SampleData}")

# Thực hiện sắp xếp
bubbleSort(SampleData)

print(f"Kết quả mong muốn: [14, 21, 27, 41, 43, 45, 46, 57, 70]")
print(f"Kết quả thực tế: {SampleData}")
