input_sentence = input("Nhập một câu: ")

count_letters = 0
count_digits = 0

for char in input_sentence:
    if char.isalpha():
        count_letters += 1
    elif char.isdigit():
        count_digits += 1

print(f"Số chữ cái: {count_letters}")
print(f"Số chữ số: {count_digits}")

