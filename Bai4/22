results = []

for num in range(1000, 3001):
    s_num = str(num)
    is_all_even = True
    
    for digit in s_num:
        digit_val = int(digit)
        if digit_val % 2 != 0:
            is_all_even = False
            break
            
    if is_all_even:
        results.append(s_num)
        
print(",".join(results))

# Ví dụ đầu ra (một phần):
# 2000,2002,2004,2006,2008,2020,2022,2024,2026,2028,2040,...
