try:
    n = int(input("Nhập số dòng n của Tam giác Pascal: "))
    
    if n <= 0:
        print("n phải là số nguyên dương.")
        exit()
        
    triangle = []
    
    for i in range(n):
        row = [1]
        if i > 0:
            last_row = triangle[-1]
            for j in range(len(last_row) - 1):
                row.append(last_row[j] + last_row[j+1])
            row.append(1)
        triangle.append(row)
        
        # In căn giữa cho đẹp mắt
        print(f"{' '.join(map(str, row)):^50}")
        
except ValueError:
    print("Đầu vào không phải là số nguyên hợp lệ.")

