try:
    n = int(input("Nhập số n: "))
    
    if n <= 0:
        print("n phải là số dương.")
    else:
        fib_list = []
        a, b = 0, 1
        
        while a < n:
            fib_list.append(a)
            a, b = b, a + b
            
        print(fib_list)
        
except ValueError:
    print("Đầu vào không phải là số nguyên hợp lệ.")

