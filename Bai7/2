file_path = 'D:/a.txt'
char_count = 0
word_count = 0
line_count = 0

try:
    with open(file_path, 'r') as file:
        for line in file:
            line_count += 1
            
            char_count += len(line)
            
            words = line.split()
            word_count += len(words)

    print("The no.of chars is %d" % char_count)
    print("The no.of words is %d" % word_count)
    print("The no.of lines is %d" % line_count)

except FileNotFoundError:
    print(f"Error: File not found at {file_path}")
