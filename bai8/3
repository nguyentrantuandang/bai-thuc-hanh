import turtle
import random

colors = ["red", "green", "blue", "orange", "purple", "pink", "yellow"]

window = turtle.Screen()

painter = turtle.Turtle()
painter.speed(0)  # Tăng tốc độ vẽ tối đa

# Số lần lặp để tạo ra hoa văn đối xứng 10 cánh
num_circles = 10 
angle = 360 / num_circles # Góc xoay 360/10 = 36 độ

for i in range(num_circles):
    color = random.choice(colors)
    painter.pencolor(color)
    painter.pensize(3)
    painter.circle(100) # Vẽ hình tròn
    painter.right(angle) # Xoay 36 độ để hình tròn tiếp theo lệch đi
